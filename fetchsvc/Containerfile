# Outbound fetch service for research sandboxes.
#
# Same base as the sandbox image (see ../Containerfile), fully qualified so it
# is not resolved through podman's unqualified-search registry list. Reusing it
# adds no new publisher to the trust path and no new layer to pull.
#
# Build: podman build -t sandbox-fetchsvc fetchsvc/

ARG BASE_IMAGE=docker.io/library/python:3.13-slim
FROM ${BASE_IMAGE}

COPY fetch_service.py /usr/local/bin/fetch_service.py

EXPOSE 8090

# Standard library only — no pip install, nothing to pin, nothing to audit.
ENTRYPOINT ["python3", "/usr/local/bin/fetch_service.py"]
CMD ["--host", "0.0.0.0", "--port", "8090"]
