# Enable telemetry
export CLAUDE_CODE_ENABLE_TELEMETRY=1
export CLAUDE_CODE_ENHANCED_TELEMETRY_BETA=1

# Metrics → OTLP → Collector → Prometheus
export OTEL_METRICS_EXPORTER=otlp
export OTEL_METRIC_EXPORT_INTERVAL=10000

# Events/Logs → OTLP → Collector → Loki
export OTEL_LOGS_EXPORTER=otlp
export OTEL_LOGS_EXPORT_INTERVAL=5000

# Traces → OTLP → Collector → Tempo
export OTEL_TRACES_EXPORTER=otlp

# OTEL_EXPORTER_OTLP_{ENDPOINT,PROTOCOL} come from /sandbox/.env — the
# destination belongs to the host that created this sandbox, not to this file.

# Include tool details and user prompts (POC only — review before sharing)
export OTEL_LOG_TOOL_DETAILS=1
export OTEL_LOG_USER_PROMPTS=1

# Both host.name and project describe the HOST, and neither is observable from
# inside the container: `hostname` is sandbox-sb-<hash> (the sandbox, not the
# machine — sandbox.source below already carries that), and $(pwd) is
# /sandbox/source/ for every sandbox on every machine. sandbox.sh injects the
# real values. The fallbacks fire only on a sandbox created before this
# existed; `sandbox.sh --refresh` rewrites .env and fixes it.
export OTEL_RESOURCE_ATTRIBUTES="user.name=${USER},project=${SANDBOX_HOST_DIR:-$(pwd)},host.name=${SANDBOX_HOST_NAME:-$(hostname)}"

if [[ -n "${SANDBOX_SOURCE_NAME+x}" ]]; then
    export OTEL_RESOURCE_ATTRIBUTES="${OTEL_RESOURCE_ATTRIBUTES},sandbox.source=${SANDBOX_SOURCE_NAME}"
fi
if [[ -n "${SANDBOX_PROFILE+x}" ]]; then
    export OTEL_RESOURCE_ATTRIBUTES="${OTEL_RESOURCE_ATTRIBUTES},sandbox.profile=${SANDBOX_PROFILE}"
fi
