#!/bin/bash
# Generated By: Claude Code (rits/deepseek-ai/DeepSeek-V4.1-Flash-1017)
#
# Sandbox-owned PATH shim for Claude Code. /sandbox/bin is first on PATH
# (config/bashrc), so every `claude` resolved by name — dtach, scripts, a
# nested `claude -p` — passes here before reaching /usr/bin.
#
# Telemetry is not set here: config/bashrc and /sandbox/.env carry it for every
# process in the container. The one attribute this adds is the headless marker,
# because Claude Code emits none of its own and a nested `claude -p` inherits
# nothing that identifies it.
#
# --dangerously-skip-permissions is not optional. The OpenShell policy is the
# security boundary; the agent's own permission system is redundant confinement
# inside it (gotcha 1 in CLAUDE.md). Added once, even when the caller passed it.

add_attr() {  # add_attr <key> <value>: append to OTEL_RESOURCE_ATTRIBUTES unless key is set
    [[ ",${OTEL_RESOURCE_ATTRIBUTES:-}," == *",$1="* ]] ||
        export OTEL_RESOURCE_ATTRIBUTES="${OTEL_RESOURCE_ATTRIBUTES:+${OTEL_RESOURCE_ATTRIBUTES},}$1=$2"
}

skip_permissions=--dangerously-skip-permissions
for arg in "$@"; do
    case "$arg" in
        -p|--print) add_attr headless true ;;
        --dangerously-skip-permissions) skip_permissions="" ;;
    esac
done

# The native CLI by absolute path, not by PATH lookup, so this shim can never
# reach itself. CLAUDE_CMD is the override the tests use; it must stay
# absolute for the same reason.
CLAUDE_CMD="${CLAUDE_CMD:-/usr/bin/claude}"
[[ "$CLAUDE_CMD" == /* ]] || { echo "claude: CLAUDE_CMD must be an absolute path, got '$CLAUDE_CMD'" >&2; exit 127; }
if [[ -n "$skip_permissions" ]]; then
    exec "$CLAUDE_CMD" "$skip_permissions" "$@"
fi
exec "$CLAUDE_CMD" "$@"
