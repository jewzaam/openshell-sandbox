#!/bin/bash
# Generated By: Claude Code (rits/deepseek-ai/DeepSeek-V4.1-Flash-1017)
#
# Sandbox-owned PATH shim for OpenCode. /sandbox/bin is first on PATH
# (config/bashrc), so every `opencode` resolved by name passes here before
# /usr/bin.
#
# --auto is not optional: the OpenShell policy is the security boundary, so
# permission prompts are redundant confinement inside it. Explicit denies still
# apply; upload_config() drops the host's permission and policy fragments on
# the way in because those encode host boundaries, not this container's. Added
# once, even when the caller passed it.
extra=(--auto)
for arg in "$@"; do [[ "$arg" == --auto ]] && extra=(); done

# OPENCODE_CMD is the override the tests use; it must stay absolute so the shim
# cannot exec itself.
OPENCODE_CMD="${OPENCODE_CMD:-/usr/bin/opencode}"
[[ "$OPENCODE_CMD" == /* ]] || { echo "opencode: OPENCODE_CMD must be an absolute path, got '$OPENCODE_CMD'" >&2; exit 127; }
exec "$OPENCODE_CMD" "${extra[@]}" "$@"
