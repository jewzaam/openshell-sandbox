#!/bin/bash
# Generated By: Claude Code (rits/deepseek-ai/DeepSeek-V4.1-Flash-1017)
#
# Sandbox-owned PATH shim for Codex. /sandbox/bin is first on PATH
# (config/bashrc), so every `codex` resolved by name passes here before
# /usr/bin.
#
# Sandbox paths are shared, so a launch must not derive its identity from
# $(pwd): /sandbox/source/ is the same for every sandbox on every machine.
# /sandbox/.env carries the host-side sandbox directory as `project` in
# OTEL_RESOURCE_ATTRIBUTES, and that inherited value wins. Without one, the
# launch directory is the only honest answer.

set -euo pipefail

project_attr=',project=([^,]*),'
if [[ ",${OTEL_RESOURCE_ATTRIBUTES:-}," =~ $project_attr ]]; then
    export CODEX_PROJECT="${CODEX_PROJECT:-${BASH_REMATCH[1]}}"
else
    export CODEX_PROJECT="${CODEX_PROJECT:-$PWD}"
    export OTEL_RESOURCE_ATTRIBUTES="${OTEL_RESOURCE_ATTRIBUTES:+${OTEL_RESOURCE_ATTRIBUTES},}project=${CODEX_PROJECT}"
fi

# --no-daemon: the managed app-server daemon captures one environment at
# startup and shares it across clients, so a per-launch project identity never
# reaches it.
#
# The two bypass flags are not optional: the OpenShell policy is the security
# boundary, so Codex's own sandbox, approval prompts and hook-trust gate are
# redundant confinement inside it. Every hook in here came from the host, so
# there is no untrusted hook for the gate to catch. Each is added once, even
# when the caller passed it — codex treats a repeated flag as an error.
extra=(--no-daemon)
for flag in --dangerously-bypass-approvals-and-sandbox --dangerously-bypass-hook-trust; do
    present=""
    for arg in "$@"; do [[ "$arg" == "$flag" ]] && present=1; done
    [[ -n "$present" ]] || extra+=("$flag")
done

# CODEX_CMD defaults to the image's symlink and is the override the tests use;
# it must stay absolute so the shim cannot exec itself.
CODEX_CMD="${CODEX_CMD:-/usr/bin/codex}"
[[ "$CODEX_CMD" == /* ]] || { echo "codex: CODEX_CMD must be an absolute path, got '$CODEX_CMD'" >&2; exit 127; }

# When harness-wrapper.sh launched this under dtach it exports CODEX_ERROR_LOG:
# Codex's startup error has to survive the dtach session, and only the wrapper
# that started dtach can report it afterwards. A fifo plus a real background tee
# job, not `2> >(tee ...)`: a process substitution is not a job, so `wait` would
# not cover it and the log could be read while tee still held the last lines.
# Outside the wrapper the variable is unset and this is a plain exec.
if [[ -n "${CODEX_ERROR_LOG:-}" ]]; then
    tmpdir="$(mktemp -d)"
    log_pipe="${tmpdir}/stderr"
    mkfifo "$log_pipe"
    tee -a "$CODEX_ERROR_LOG" < "$log_pipe" >&2 &
    tee_pid=$!

    status=0
    "$CODEX_CMD" "${extra[@]}" "$@" 2>"$log_pipe" || status=$?

    wait "$tee_pid" || true
    rm -rf "$tmpdir"
    exit "$status"
fi
exec "$CODEX_CMD" "${extra[@]}" "$@"
