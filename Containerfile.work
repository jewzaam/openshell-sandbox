# Generated By: Claude Code (claude-opus-5)
#
# Work variant of the sandbox image. `deniedModels` is honored only from
# managed settings, and the Linux path is /etc/claude-code/managed-settings.json
# — root-owned, with /etc read_only in every policy. That is the point: a
# runtime upload needs a writable destination, and anything the sandbox user can
# write the agent can rewrite to unblock the denied models. Baking at build time
# is the only copy the sandbox cannot edit.
#
# The file comes from the host via `make build` (stage-managed-settings), so the
# host's managed settings stay the single source of truth.
#
# Build: make build

ARG BASE_IMAGE=openshell-sandbox:latest
FROM ${BASE_IMAGE}

COPY --chown=root:root .tmp-managed-settings.json /etc/claude-code/managed-settings.json
