#!/usr/bin/env bash
# Generated By: Claude Code (Claude Opus 4.6)
#
# Open a sandbox-backed VS Code session for code review.
# Creates or reconnects to a sandbox named <repo>-<ref>, with
# VS Code tasks that auto-launch Claude inside the sandbox.

set -euo pipefail

# One checkout drives one sandbox: scode, lib.sh, and sandbox.sh all come from
# here unless $SANDBOX_SH says otherwise. readlink -f so a symlink into ~/bin
# still resolves to the real repo. An absolute default let a scode from one
# checkout hand the work to another checkout's sandbox.sh, which is how a
# manifest fix in one and not the other went unnoticed.
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
SANDBOX_SH="${SANDBOX_SH:-${SCRIPT_DIR}/sandbox.sh}"
SANDBOXES_DIR="${HOME}/sandboxes"

if [[ " $* " == *" --help "* ]] || [[ " $* " == *" -h "* ]]; then
    cat << 'EOF'
Usage: scode [OPTIONS] [JIRA_URL | PR_URL... | SANDBOX_DIR | --name NAME | SOURCE_PATH [REF|LABEL]]

Open a directory in VS Code backed by an OpenShell sandbox running Claude.

Options:
  --profile NAME   Credential profile (e.g., personal). Passed to sandbox.sh.
                   Defaults to DEFAULT_PROFILE in config/site.env.

Modes:
  scode JIRA_URL                    Jira issue URL — fetch context, no repos
  scode PR_URL [PR_URL ...]         GitHub PR URL(s) — multi-repo review
  scode SANDBOX_DIR                 Re-use existing sandbox from manifest.json
  scode SOURCE_PATH [REF|LABEL]     Auto-name sandbox <repo>-<ref|label>, clone repo
  scode --name NAME                 Custom name, no repos (add with sandbox.sh --add-repo)

Arguments:
  JIRA_URL       https://redhat.atlassian.net/browse/AAP-87003
  PR_URL         https://github.com/org/repo/pull/123
  SANDBOX_DIR    Path to existing ~/sandboxes/<name>/ with manifest.json
  SOURCE_PATH    Path to local git repo (e.g., ~/source/myapp)
  REF            Branch, PR, tag, or SHA (default: repo's default branch)
  LABEL          Any word that is not a ref — names the sandbox and checks out
                 the default branch. For running two sandboxes on one repo.

Examples:
  scode https://redhat.atlassian.net/browse/AAP-87003
  scode https://github.com/org/myapp/pull/1109
  scode https://github.com/org/repo1/pull/42 https://github.com/org/repo2/pull/99
  scode ~/sandboxes/supply-chain
  scode ~/source/myapp pr/1176                   # ref     -> myapp-pr-1176
  scode ~/source/my-great-project big-feature    # label   -> my-great-project-big-feature
  scode --profile personal ~/source/my-project
  scode --name review-workspace
EOF
    exit 0
fi

SCODE_PROFILE=""
POSITIONAL=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --profile)
            [[ $# -ge 2 ]] || { echo "error: --profile requires NAME" >&2; exit 1; }
            SCODE_PROFILE="$2"
            shift 2
            ;;
        *)
            POSITIONAL+=("$1")
            shift
            ;;
    esac
done
set -- "${POSITIONAL[@]+"${POSITIONAL[@]}"}"

if [[ $# -lt 1 ]]; then
    echo "error: requires --name NAME, SOURCE_PATH, or SANDBOX_DIR" >&2
    echo "usage: scode [--profile NAME] [--name NAME | SOURCE_PATH [REF|LABEL] | ~/sandboxes/<name>]" >&2
    exit 1
fi

PROFILE_FLAG=""
if [[ -n "$SCODE_PROFILE" ]]; then
    PROFILE_FLAG=" --profile ${SCODE_PROFILE}"
fi

# scode's OWN lib.sh, not $SANDBOX_SH's. They are usually the same checkout,
# but SANDBOX_SH defaults to a fixed absolute path — so `./scripts/scode` out
# of a second checkout or a worktree used to run this script against the other
# copy's library, and picked up whatever functions that one happened to have.
source "${SCRIPT_DIR}/lib.sh"

# The profile the sandbox will actually be built with: on a DEFAULT_PROFILE
# machine that is the site default even with no --profile on the command line.
EFFECTIVE_PROFILE="${SCODE_PROFILE:-$(site_default_profile)}"

write_tasks_and_open() {
    local dir="$1" cmd="$2"

    # Before `code`, not after: the VS Code terminals open with the folder and
    # a prompt that reads .profile out of manifest.json. Left to sandbox.sh,
    # the file only lands after create + clone + upload, and every shell until
    # then shows the wrong thing. An existing manifest is left alone — its
    # profile is what the sandbox was built with, and sandbox.sh --ensure
    # errors on a mismatch rather than letting scode overwrite it here.
    if [[ ! -f "${dir}/manifest.json" ]]; then
        init_manifest "$dir" "$sandbox_name" "$EFFECTIVE_PROFILE"
    fi

    mkdir -p "${dir}/.vscode"
    if [[ ! -f "${dir}/.vscode/tasks.json" ]]; then
        cat > "${dir}/.vscode/tasks.json" << TASKS
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "sandbox",
      "type": "shell",
      "command": "${cmd}",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "sandbox-dev"
      },
      "runOptions": {"runOn": "folderOpen"}
    },
    {
      "label": "bash",
      "type": "shell",
      "command": "exec bash -li",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "sandbox-dev"
      },
      "runOptions": {"runOn": "folderOpen"}
    }
  ]
}
TASKS
    fi
    code "${dir}"
}

# --- Jira URL mode: scode https://redhat.atlassian.net/browse/AAP-87003 ---
if [[ "$1" =~ ^https://[^/]+/browse/([A-Za-z]+-[0-9]+)$ ]]; then
    jira_key="${BASH_REMATCH[1]}"
    sandbox_name="${jira_key,,}"

    sandbox_dir="${SANDBOXES_DIR}/${sandbox_name}"
    mkdir -p "${sandbox_dir}"

    echo "fetching Jira context for ${jira_key}..." >&2
    auth=$(jira_auth) || { echo "error: JIRA_USERNAME/JIRA_TOKEN not set" >&2; exit 1; }
    {
        echo "# Jira Context"
        echo ""
        fetch_jira_context "$jira_key" "$auth"
    } > "${sandbox_dir}/jira-context.md"
    echo "  wrote ${sandbox_dir}/jira-context.md" >&2

    write_tasks_and_open "${sandbox_dir}" "${SANDBOX_SH} --ensure ${sandbox_name}${PROFILE_FLAG}"
    exit 0
fi

# --- PR URL mode: scode PR_URL [PR_URL ...] ---
# Check if all positional args are PR URLs (supports multi-repo review)
_all_prs=true
for _arg in "$@"; do
    [[ "$_arg" =~ ^https://github\.com/[^/]+/[^/]+/pull/[0-9]+$ ]] || { _all_prs=false; break; }
done

if [[ "$_all_prs" == true ]]; then
    ENSURE_CMD=""
    for _pr_url in "$@"; do
        [[ "$_pr_url" =~ ^https://github\.com/([^/]+/[^/]+)/pull/([0-9]+)$ ]]
        gh_repo="${BASH_REMATCH[1]}"
        pr_num="${BASH_REMATCH[2]}"
        repo_url="git@github.com:${gh_repo}.git"
        repo_name="$(basename "$gh_repo")"
        ref="pr/${pr_num}"

        # The guard must see the profile the sandbox will actually be built
        # with, not just what was typed — hence EFFECTIVE_PROFILE.
        SANDBOX_PROFILE="$EFFECTIVE_PROFILE" guard_private_repo "$repo_url"

        # Name sandbox after first PR
        if [[ -z "$ENSURE_CMD" ]]; then
            sandbox_name="${repo_name}-pr-${pr_num}"
            ENSURE_CMD="${SANDBOX_SH} --ensure ${sandbox_name}${PROFILE_FLAG}"
        fi

        ENSURE_CMD+=" --repo ${repo_url} --ref ${ref}"
    done

    sandbox_dir="${SANDBOXES_DIR}/${sandbox_name}"
    write_tasks_and_open "${sandbox_dir}" "${ENSURE_CMD}"
    exit 0
fi

# --- Existing sandbox dir mode: re-use from manifest ---
target_path="$(realpath "$1" 2>/dev/null || echo "$1")"
if [[ -f "${target_path}/manifest.json" ]]; then
    sandbox_name="$(jq -r '.name' "${target_path}/manifest.json")"

    # Read profile from manifest if not specified on CLI
    if [[ -z "$SCODE_PROFILE" ]]; then
        manifest_profile="$(jq -r '.profile // empty' "${target_path}/manifest.json" 2>/dev/null)" || true
        if [[ -n "$manifest_profile" ]]; then
            PROFILE_FLAG=" --profile ${manifest_profile}"
        fi
    fi

    ENSURE_CMD="${SANDBOX_SH} --ensure ${sandbox_name}${PROFILE_FLAG}"
    while IFS=$'\t' read -r repo_name repo_url repo_ref; do
        ENSURE_CMD+=" --repo ${repo_url}"
        if [[ -n "$repo_ref" && "$repo_ref" != "null" ]]; then
            ENSURE_CMD+=" --ref ${repo_ref}"
        fi
    done < <(jq -r '.repos | to_entries[] | [.key, .value.url, .value.ref] | @tsv' "${target_path}/manifest.json")

    write_tasks_and_open "${target_path}" "${ENSURE_CMD}"
    exit 0
fi

# --- Name-only mode: custom sandbox, no repos ---
if [[ "$1" == "--name" ]]; then
    [[ $# -ge 2 ]] || { echo "error: --name requires NAME" >&2; exit 1; }
    sandbox_name="$2"
    sandbox_dir="${SANDBOXES_DIR}/${sandbox_name}"

    write_tasks_and_open "${sandbox_dir}" "${SANDBOX_SH} --ensure ${sandbox_name}${PROFILE_FLAG}"
    exit 0
fi

# --- Repo mode: auto-name from repo + ref ---
source_path="$(realpath "$1")"

if [[ ! -d "$source_path/.git" ]]; then
    echo "error: ${source_path} is not a git repository" >&2
    exit 1
fi

# Second positional is a REF if it names one, otherwise a LABEL. Two sandboxes
# on the same repo need two names, and the name is the only thing the user has
# to remember — so `scode ~/source/proj big-feature` names it proj-big-feature
# and checks out the default branch. Branch juggling inside the sandbox is
# cheap; remembering a naming convention is not.
#
# The ambiguity is benign: a LABEL that happens to match a local branch is read
# as a REF, and both spellings produce the SAME sandbox name — only the checked
# out branch differs. pr/N and tag/X are matched by pattern because sandbox.sh
# resolves them remotely; they need not exist in the local clone.
is_ref() {
    [[ "$2" =~ ^(pr/[0-9]+|tag/.+)$ ]] && return 0
    git -C "$1" rev-parse --verify --quiet "$2" >/dev/null 2>&1
}

label=""
ref=""
if [[ $# -ge 2 ]] && is_ref "$source_path" "$2"; then
    ref="$2"
else
    [[ $# -ge 2 ]] && label="${2//\//-}"
    ref="$(git -C "$source_path" symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's|refs/remotes/origin/||')" || true
    if [[ -z "$ref" ]]; then
        echo "error: cannot detect default branch (no origin/HEAD). Specify REF explicitly" >&2
        exit 1
    fi
fi

repo_name="$(basename "$source_path")"
sandbox_name="${repo_name}-${label:-${ref//\//-}}"

repo_url="$(git -C "$source_path" remote get-url origin 2>/dev/null)" || {
    echo "error: no origin remote in ${source_path}" >&2
    exit 1
}

# Block private repos for personal profile before opening VS Code
SANDBOX_PROFILE="$EFFECTIVE_PROFILE" guard_private_repo "$repo_url"

sandbox_dir="${SANDBOXES_DIR}/${sandbox_name}"
write_tasks_and_open "${sandbox_dir}" "${SANDBOX_SH} --ensure ${sandbox_name}${PROFILE_FLAG} --repo ${repo_url} --ref ${ref} --source-dir ${source_path}"
